# Folio configuration for docker compose. Copy to .env (git-ignored) and edit.
# Every variable is documented in the README "Configuration" table.

# Base URL that download links are built from. Must be reachable by whoever
# opens the links (your public https URL in production).
FOLIO_PUBLIC_URL=http://localhost:8080

# Access token: 32-256 characters of [A-Za-z0-9._~+/=-]. Generate one with
#   openssl rand -hex 32
FOLIO_TOKEN=

# Several named tokens instead (the name is recorded as the author):
# FOLIO_TOKENS=alice:<token>,bob:<token>

# Optional AI visual reviewer (page images are sent to OpenRouter):
# FOLIO_OPENROUTER_API_KEY=
# FOLIO_REVIEW_MODEL=google/gemma-4-31b-it

# FOLIO_LOG_FORMAT=text
# FOLIO_RENDER_CONCURRENCY=2
