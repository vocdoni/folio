        },
        "deliverables": {
          "$ref": "folio:component/deliverables"
        },
        "signatures": {
          "$ref": "folio:component/signatures"
        }
      }
    },
    "sections": [
      {
        "title": "Executive summary",
        "required": true,
        "aliases": [
          "Summary",
          "Resumen ejecutivo",
          "Resum executiu"
        ],
        "hint": "Two or three paragraphs: the problem, the proposal, the outcome."
      },
      {
        "title": "Context",
        "aliases": [
          "Contexto",
          "Context"
        ]
      },
      {
        "title": "Scope",
        "required": true,
        "aliases": [
          "Alcance",
          "Abast"
        ],
        "hint": "Bullet list of what is included."
      },
      {
        "title": "Approach",
        "aliases": [
          "Enfoque",
          "Enfocament"
        ]
      },
      {
        "title": "Plan",
        "aliases": [
          "Planificación",
          "Planificació"
        ],
        "component": "milestones"
      },
      {
        "title": "Deliverables",
        "aliases": [
          "Entregables",
          "Lliurables"
        ],
        "component": "deliverables"
      },
      {
        "title": "Budget",
        "required": true,
        "aliases": [
          "Presupuesto",
          "Pressupost"
        ],
        "component": "budget"
      },
      {
        "title": "Terms",
        "aliases": [
          "Condiciones",
          "Condicions"
        ]
      },
      {
        "title": "Acceptance",
        "aliases": [
          "Aceptación",
          "Acceptació"
        ],
        "component": "signatures"
      }
    ],
    "components": [
      "budget",
      "milestones",
      "deliverables",
      "signatures",
      "info"
    ],
    "strict": false,
    "body_skeleton": "# Executive summary\n\nTODO\n\n::: folio-info\n:::\n\n# Scope\n\n- TODO\n\n# Plan\n\n::: folio-milestones\n:::\n\n# Deliverables\n\n::: folio-deliverables\n:::\n\n# Budget\n\n::: folio-budget\n:::\n\n# Acceptance\n\n::: folio-signatures\n:::\n",
    "sample": {
      "markdown": "# Executive summary\n\nExample Co proposes to redesign the ACME public website so that customers find products faster and the team can publish content without developer help.\n\n::: folio-info\n:::\n\n# Context\n\nACME's current site was built in 2019. Analytics show that 60% of visitors leave from the product listing pages.\n\n# Scope\n\n- Information architecture and navigation\n- Visual design system and page templates\n- Content migration of 120 product pages\n- Analytics and accessibility review (WCAG 2.2 AA)\n\n# Approach\n\nWe work in two-week iterations with a demo at the end of each one.\n\n# Plan\n\n::: folio-milestones\n:::\n\n# Deliverables\n\n::: folio-deliverables\n:::\n\n# Budget\n\n::: folio-budget\n:::\n\n# Terms\n\nPrices exclude travel. Invoices are payable within 30 days.\n\n# Acceptance\n\n::: folio-signatures\n:::\n",
      "metadata": {
        "title": "Website redesign proposal",
        "date": "2026-10-18",
        "language": "en",
        "client": "ACME Corp",
        "project": "Website redesign",
        "reference": "EX-2026-041",
